# Public HTTPS address shown in renewal emails and accepted by origin checks.
APP_URL=https://members.example.org

# The Node server must only listen locally when Apache/Nginx proxies to it.
HOST=127.0.0.1
PORT=4173
TRUST_PROXY=1

# Optional comma-separated additional origins, normally left empty.
TRUSTED_ORIGINS=

# Set these to the Virtualmin account's numeric IDs: run `id -u` and `id -g`.
PUID=1000
PGID=1000

# Store private JSON records outside public_html in production.
RAYNET_DATA_DIR=/home/example/hub-data

# Storage backend: json (default) or mysql.
STORAGE_DRIVER=json

# Required only when STORAGE_DRIVER=mysql. Create the database and user in
# Virtualmin first; the CRM creates its own raynet_crm_store table.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=raynet_members
MYSQL_USER=raynet_members
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_SSL=0
